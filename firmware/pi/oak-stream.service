[Unit]
# Runs the camera stream from boot. Started by hand in an SSH session it dies
# with the session, which looks from the badge like a network fault and is not
# one -- that cost a debugging round.
Description=OAK-1 MJPEG stream for the badge
Documentation=https://github.com/aryan-vasudevan/drone-hacking
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
# Cloud detection needs an API key and a flag, and the key must never be in
# the repo -- so both come from a file that only exists on the Pi:
#
#     sudo tee /etc/default/oak-stream <<'EOF'
#     RF_API_KEY=...
#     OAK_ARGS=--detect
#     EOF
#     sudo systemctl restart oak-stream
#
# The leading "-" makes it optional: with no such file the stream runs exactly
# as it always has, video only. Point RF_URL at a dedicated deployment there
# too if there is one.
EnvironmentFile=-/etc/default/oak-stream
ExecStart=/home/pi/oak/bin/python -u /home/pi/oak_stream.py $OAK_ARGS

# The OAK is on USB and can take a moment to be claimable after a reboot, and
# the badge retries forever anyway, so restarting is always the right answer.
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal

# Needs raw USB access to the Myriad X, so it cannot be locked down as hard as
# the button listener. PrivateTmp is still free.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
