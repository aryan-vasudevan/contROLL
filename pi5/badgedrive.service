[Unit]
# Drives the car from the badge, from boot. Started by hand over SSH it dies
# with the session, and the point of this pair is that you power the Pi, power
# the badge, and drive.
Description=Drive the car from the badge buttons
After=network.target NetworkManager.service
Wants=network.target

# badge-listen binds the same UDP port and only logs. This replaces it: it
# answers the badge the same way, so the LEDs still go green.
Conflicts=badge-listen.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -u /home/pi/badgedrive.py --quiet

# The motors are cut by the script on every exit path, and again by the next
# start. Restarting is always right: a dead controller leaves a car that
# cannot be stopped from the badge.
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal

# Needs the GPIO character device, so it cannot be locked down as hard as the
# listener was.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
